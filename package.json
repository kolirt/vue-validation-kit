{
  "name": "@kolirt/vue-validation-kit",
  "version": "1.0.1",
  "type": "module",
  "description": "A lightweight, Laravel-inspired validation package for Vue 3",
  "author": "kolirt",
  "private": false,
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "vuejs",
    "validation",
    "validator",
    "form"
  ],
  "scripts": {
    "build-lib": "run-p type-check-lib build-only-lib",
    "build-only-lib": "vite build -c vite.lib.config.ts",
    "type-check-lib": "vue-tsc --noEmit -p tsconfig.lib.json --composite false",
    "dev-demo": "vite serve -c vite.demo.config.ts",
    "build-demo": "vite build -c vite.demo.config.ts",
    "preview-demo": "vite preview -c vite.demo.config.ts",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore --ignore-path .eslintignore",
    "format": "prettier --write \"**/*.{ts,js,cjs,vue,json}\""
  },
  "pre-commit": [
    "lint",
    "type-check-lib"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./localization": {
      "import": "./dist/localization/index.js",
      "require": "./dist/localization/index.cjs",
      "types": "./dist/localization/index.d.ts"
    },
    "./rules": {
      "import": "./dist/rules/index.js",
      "require": "./dist/rules/index.cjs",
      "types": "./dist/rules/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/kolirt/vue-validation-kit"
  },
  "bugs": {
    "url": "https://github.com/kolirt/vue-validation-kit/issues"
  },
  "homepage": "https://github.com/kolirt/vue-validation-kit#readme",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "@kyvg/vue3-notification": "^2.9.1",
    "bootstrap": "5.3.0",
    "lodash": "^4.17.21",
    "vue": "^3.3.2"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.2.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@tsconfig/node18": "^2.0.1",
    "@types/lodash": "^4.17.10",
    "@types/node": "^18.16.8",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/tsconfig": "^0.4.0",
    "eslint": "^8.39.0",
    "eslint-plugin-vue": "^9.11.0",
    "npm-run-all": "^4.1.5",
    "pre-commit": "^1.2.2",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "sass": "^1.63.6",
    "typescript": "~5.0.4",
    "vite": "^5.4.8",
    "vite-plugin-dts": "^2.3.0",
    "vite-plugin-eslint": "^1.8.1",
    "vue-tsc": "^1.6.4"
  }
}
